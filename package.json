{
  "name": "studyvillage",
  "version": "0.8.0",
  "description": "교실용 학습 RPG 서버 및 학생 웹앱",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "verify": "node --check electron/main.cjs && node --check server/server.js && node --check game.js && node --check avatar-renderer.js && node --check avatar-motion.js && node --check world-camera.js && node --check customize.js && node --check auth.js && node --check data-service.js && node --check admin.js",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.school.studyvillage",
    "productName": "Studyvillage",
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "files": ["index.html","style.css","avatar-assets.css","game.js","avatar-renderer.js","avatar-motion.js","world-camera.js","customize.js","auth.js","data-service.js","admin.html","admin.css","admin.js","connect.html","assets/**/*","server/**/*","electron/**/*","CLASSROOM-QUICKSTART.txt","package.json"],
    "win": {"target":["portable"],"artifactName":"Studyvillage-${version}-portable.${ext}"}
  }
}