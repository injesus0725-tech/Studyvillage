{
  "name": "studyvillage",
  "version": "0.5.1",
  "description": "교실용 학습 RPG 서버 및 학생 웹앱",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.school.studyvillage",
    "productName": "Studyvillage",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "auth.js",
      "data-service.js",
      "admin.html",
      "admin.css",
      "admin.js",
      "connect.html",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "Studyvillage-${version}-portable.${ext}"
    }
  }
}